<Window x:Class="YuandaoTws.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="原点" Width="980" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Background="Transparent" FontFamily="Segoe UI Variable Text"
        DataContext="{Binding RelativeSource={RelativeSource Self}, Path=ViewModel}">
    <Window.Resources>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    </Window.Resources>
    <Border Margin="18" CornerRadius="26" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="28">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="DragWindow"><StackPanel><TextBlock Text="ORIGIN" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="原点" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="你的声音，保持在掌控之中" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="9" Height="9" Fill="{Binding ConnectionDotBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Button Content="×" Style="{StaticResource GlassButton}" Margin="20,0,0,0" Padding="10,3" Click="CloseWindow"/></StackPanel></Grid>
            <Border Grid.Row="1" Margin="0,24,0,18" Padding="18" CornerRadius="18" Background="{DynamicResource SurfaceBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="左耳" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding LeftBatteryText}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding LeftChargeText}" Foreground="{DynamicResource AccentBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="右耳" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding RightBatteryText}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding RightChargeText}" Foreground="{DynamicResource AccentBrush}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="充电盒" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding CaseBatteryText}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding DeviceName}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.22*"/><ColumnDefinition Width="0.78*"/></Grid.ColumnDefinitions><Border Margin="0,0,10,0" Padding="20" CornerRadius="18" Background="{DynamicResource SurfaceBrush}"><StackPanel><TextBlock Text="降噪模式" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding AncModeText}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,18"/><WrapPanel><Button Content="关闭" Command="{Binding SetAncCommand}" CommandParameter="Off" Style="{StaticResource GlassButton}"/><Button Content="通透" Command="{Binding SetAncCommand}" CommandParameter="Transparency" Style="{StaticResource GlassButton}"/><Button Content="普通" Command="{Binding SetAncCommand}" CommandParameter="Normal" Style="{StaticResource GlassButton}"/><Button Content="深度" Command="{Binding SetAncCommand}" CommandParameter="Deep" Style="{StaticResource PrimaryButton}"/><Button Content="试验" Command="{Binding SetAncCommand}" CommandParameter="Experimental" Style="{StaticResource GlassButton}"/><Button Content="风噪抑制" Command="{Binding SetAncCommand}" CommandParameter="WindSuppression" Style="{StaticResource GlassButton}"/></WrapPanel><TextBlock Text="均衡器" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,24,0,4"/><TextBlock Text="{Binding EqualizerText}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/><WrapPanel><Button Content="悔恨之泪" Command="{Binding SetEqualizerCommand}" CommandParameter="Blue" Style="{StaticResource GlassButton}"/><Button Content="均衡中正" Command="{Binding SetEqualizerCommand}" CommandParameter="Balanced" Style="{StaticResource GlassButton}"/><Button Content="欧美澎湃" Command="{Binding SetEqualizerCommand}" CommandParameter="Bass" Style="{StaticResource GlassButton}"/><Button Content="真律还原" Command="{Binding SetEqualizerCommand}" CommandParameter="Pure" Style="{StaticResource GlassButton}"/><Button Content="游戏优化" Command="{Binding SetEqualizerCommand}" CommandParameter="Game" Style="{StaticResource GlassButton}"/><Button Content="细腻佳音" Command="{Binding SetEqualizerCommand}" CommandParameter="Fine" Style="{StaticResource GlassButton}"/><Button Content="温婉人声" Command="{Binding SetEqualizerCommand}" CommandParameter="Vocal" Style="{StaticResource GlassButton}"/></WrapPanel></StackPanel></Border><Border Grid.Column="1" Padding="20" CornerRadius="18" Background="{DynamicResource SurfaceBrush}"><StackPanel><TextBlock Text="设备状态" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding FirmwareText}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,20"/><CheckBox Content="游戏模式" IsChecked="{Binding GameModeEnabled}" Command="{Binding ToggleCommand}" CommandParameter="GameMode" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14"/><CheckBox Content="低延迟" IsChecked="{Binding LowLatencyEnabled}" Command="{Binding ToggleCommand}" CommandParameter="LowLatency" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14"/><CheckBox Content="双设备连接" IsChecked="{Binding DualConnectionEnabled}" Command="{Binding ToggleCommand}" CommandParameter="DualConnection" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14"/><CheckBox Content="入耳检测" IsChecked="{Binding InEarEnabled}" Command="{Binding ToggleCommand}" CommandParameter="InEarDetection" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14"/><Button Content="连接设备" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Margin="0,22,0,0"/><Button Content="断开连接" Command="{Binding DisconnectCommand}" Style="{StaticResource GlassButton}"/></StackPanel></Border></Grid>
            <TextBlock Grid.Row="3" Text="{Binding HintText}" Foreground="{DynamicResource MutedBrush}" Margin="2,18,0,0"/>
        </Grid>
    </Border>
</Window>
