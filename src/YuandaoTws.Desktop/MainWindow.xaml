<Window x:Class="YuandaoTws.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:enums="clr-namespace:YuandaoTws.Domain.Enums;assembly=YuandaoTws.Domain"
        xmlns:models="clr-namespace:YuandaoTws.Domain.Models;assembly=YuandaoTws.Domain"
        xmlns:conv="clr-namespace:YuandaoTws.Desktop.Converters"
        xmlns:viewModels="clr-namespace:YuandaoTws.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="原点耳机控制" Icon="Assets/app.ico" Width="1000" Height="680" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource BackgroundBrush}" FontFamily="Microsoft YaHei UI" FontSize="13"
        d:DataContext="{d:DesignInstance Type=viewModels:DashboardViewModel, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBoolean" />
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ════════════ 标题栏 ════════════ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid MouseLeftButtonDown="DragWindow" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="原" FontSize="17" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="原点耳机控制" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="ORIGIN AUDIO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Ellipse Width="9" Height="9" Fill="{Binding ConnectionDotBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                    </StackPanel>
                    <Button Content="&#xE921;" Style="{StaticResource WindowButton}" Click="MinimizeWindow" />
                    <Button Content="&#xE8BB;" Style="{StaticResource WindowCloseButton}" Click="CloseWindow" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════ 内容区 ════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="318" />
            </Grid.ColumnDefinitions>

            <!-- ── 主列：设备状态 + 降噪 + 均衡器 ── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="28,26,16,24">
                <StackPanel Margin="0,0,12,0">

                    <!-- 设备与电量卡片 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding DeviceName}" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DeviceSubText}" Style="{StaticResource SectionCaption}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding FirmwareText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right" />
                                    <TextBlock Text="固件版本" Style="{StaticResource SectionCaption}" TextAlignment="Right" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Separator Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <!-- 左耳 -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="左耳" Style="{StaticResource StatLabel}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding LeftBatteryText}" FontSize="30" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding LeftChargeText}" FontSize="12" Foreground="{StaticResource WarningBrush}"
                                                   VerticalAlignment="Bottom" Margin="8,0,0,6" />
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource BatteryBar}" Value="{Binding LeftBatteryValue}" Margin="0,10,0,0" />
                                </StackPanel>

                                <!-- 右耳 -->
                                <StackPanel Grid.Column="1" Margin="28,0,0,0">
                                    <TextBlock Text="右耳" Style="{StaticResource StatLabel}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding RightBatteryText}" FontSize="30" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding RightChargeText}" FontSize="12" Foreground="{StaticResource WarningBrush}"
                                                   VerticalAlignment="Bottom" Margin="8,0,0,6" />
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource BatteryBar}" Value="{Binding RightBatteryValue}" Margin="0,10,0,0" />
                                </StackPanel>

                                <!-- 充电盒 -->
                                <StackPanel Grid.Column="2" Margin="28,0,0,0">
                                    <TextBlock Text="充电盒" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding CaseBatteryText}" FontSize="30" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" />
                                    <ProgressBar Style="{StaticResource BatteryBar}" Value="{Binding CaseBatteryValue}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 降噪模式卡片 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" IsEnabled="{Binding IsConnected}">
                        <StackPanel>
                            <TextBlock Text="降噪模式" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding AncDetailText}" Style="{StaticResource SectionCaption}" Margin="0,4,0,16" />
                            <Border Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="10" Padding="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Style="{StaticResource SegmentItem}" Content="关闭"
                                                 IsChecked="{Binding AncMode, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Off}"
                                                 Command="{Binding SetAncCommand}" CommandParameter="{x:Static enums:NoiseCancellingMode.Off}" />
                                <RadioButton Grid.Column="1" Style="{StaticResource SegmentItem}" Content="通透"
                                             IsChecked="{Binding AncMode, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Transparency}"
                                             Command="{Binding SetAncCommand}" CommandParameter="{x:Static enums:NoiseCancellingMode.Transparency}" />
                                <RadioButton Grid.Column="2" Style="{StaticResource SegmentItem}" Content="普通"
                                             IsChecked="{Binding AncMode, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Normal}"
                                             Command="{Binding SetAncCommand}" CommandParameter="{x:Static enums:NoiseCancellingMode.Normal}" />
                                <RadioButton Grid.Column="3" Style="{StaticResource SegmentItem}" Content="深度"
                                             IsChecked="{Binding AncMode, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Deep}"
                                             Command="{Binding SetAncCommand}" CommandParameter="{x:Static enums:NoiseCancellingMode.Deep}" />
                                <RadioButton Grid.Column="4" Style="{StaticResource SegmentItem}" Content="试验"
                                             IsChecked="{Binding AncMode, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Experimental}"
                                             Command="{Binding SetAncCommand}" CommandParameter="{x:Static enums:NoiseCancellingMode.Experimental}" />
                                <RadioButton Grid.Column="5" Style="{StaticResource SegmentItem}" Content="风噪"
                                             IsChecked="{Binding AncMode, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=WindSuppression}"
                                             Command="{Binding SetAncCommand}" CommandParameter="{x:Static enums:NoiseCancellingMode.WindSuppression}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 均衡器卡片 -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" IsEnabled="{Binding IsConnected}">
                        <StackPanel>
                            <TextBlock Text="均衡器" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding EqualizerDetailText}" Style="{StaticResource SectionCaption}" Margin="0,4,0,16" />
                            <WrapPanel>
                                <RadioButton Style="{StaticResource ChipItem}" Content="悔恨之泪"
                                             IsChecked="{Binding Equalizer, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Blue}"
                                             Command="{Binding SetEqualizerCommand}" CommandParameter="{x:Static models:EqualizerPreset.Blue}" />
                                <RadioButton Style="{StaticResource ChipItem}" Content="均衡中正"
                                             IsChecked="{Binding Equalizer, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Balanced}"
                                             Command="{Binding SetEqualizerCommand}" CommandParameter="{x:Static models:EqualizerPreset.Balanced}" />
                                <RadioButton Style="{StaticResource ChipItem}" Content="欧美澎湃"
                                             IsChecked="{Binding Equalizer, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Bass}"
                                             Command="{Binding SetEqualizerCommand}" CommandParameter="{x:Static models:EqualizerPreset.Bass}" />
                                <RadioButton Style="{StaticResource ChipItem}" Content="真律还原"
                                             IsChecked="{Binding Equalizer, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Pure}"
                                             Command="{Binding SetEqualizerCommand}" CommandParameter="{x:Static models:EqualizerPreset.Pure}" />
                                <RadioButton Style="{StaticResource ChipItem}" Content="游戏优化"
                                             IsChecked="{Binding Equalizer, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Game}"
                                             Command="{Binding SetEqualizerCommand}" CommandParameter="{x:Static models:EqualizerPreset.Game}" />
                                <RadioButton Style="{StaticResource ChipItem}" Content="细腻佳音"
                                             IsChecked="{Binding Equalizer, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Fine}"
                                             Command="{Binding SetEqualizerCommand}" CommandParameter="{x:Static models:EqualizerPreset.Fine}" />
                                <RadioButton Style="{StaticResource ChipItem}" Content="温婉人声"
                                             IsChecked="{Binding Equalizer, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Vocal}"
                                             Command="{Binding SetEqualizerCommand}" CommandParameter="{x:Static models:EqualizerPreset.Vocal}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── 侧栏：声音与连接偏好 ── -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <StackPanel Margin="22,26,22,24">
                    <TextBlock Text="声音与连接偏好" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="连接后可调整以下设置。" Style="{StaticResource SectionCaption}" Margin="0,4,0,18" />

                    <StackPanel IsEnabled="{Binding IsConnected}">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="游戏模式" Style="{StaticResource StatLabel}" VerticalAlignment="Center" />
                            <ToggleButton Grid.Column="1" IsChecked="{Binding GameModeEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding SetToggleCommand}" CommandParameter="GameMode" Style="{StaticResource SwitchToggle}" />
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="低延迟" Style="{StaticResource StatLabel}" VerticalAlignment="Center" />
                            <ToggleButton Grid.Column="1" IsChecked="{Binding LowLatencyEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding SetToggleCommand}" CommandParameter="LowLatency" Style="{StaticResource SwitchToggle}" />
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="双设备连接" Style="{StaticResource StatLabel}" VerticalAlignment="Center" />
                            <ToggleButton Grid.Column="1" IsChecked="{Binding DualConnectionEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding SetToggleCommand}" CommandParameter="DualConnection" Style="{StaticResource SwitchToggle}" />
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="入耳检测" Style="{StaticResource StatLabel}" VerticalAlignment="Center" />
                            <ToggleButton Grid.Column="1" IsChecked="{Binding InEarEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding SetToggleCommand}" CommandParameter="InEarDetection" Style="{StaticResource SwitchToggle}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="抗风噪" Style="{StaticResource StatLabel}" VerticalAlignment="Center" />
                            <ToggleButton Grid.Column="1" IsChecked="{Binding WindSuppressionEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding SetToggleCommand}" CommandParameter="WindSuppression" Style="{StaticResource SwitchToggle}" />
                        </Grid>
                    </StackPanel>

                    <Border Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="10" Padding="14,12" Margin="0,22,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ConnectionDotBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionSubText}" Style="{StaticResource SectionCaption}"
                                       TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
