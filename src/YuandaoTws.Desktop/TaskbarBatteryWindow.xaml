<Window x:Class="YuandaoTws.Desktop.TaskbarBatteryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="196" Height="34"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True"
        Background="Transparent" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="#E018202B" BorderBrush="#52FFFFFF" BorderThickness="1" CornerRadius="10" Padding="7,3" Cursor="Hand" MouseLeftButtonUp="OpenMainWindow">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="23" Height="23" Background="#287FD3" CornerRadius="7" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="原" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="1" Background="#2EFFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="7" Padding="7,1" Margin="2,0,3,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="左耳" Foreground="#B7C9D8" FontSize="8" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding LeftBatteryText}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#2EFFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="7" Padding="7,1" Margin="3,0,0,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="右耳" Foreground="#B7C9D8" FontSize="8" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding RightBatteryText}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
