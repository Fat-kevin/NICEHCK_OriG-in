<Window x:Class="YuandaoTws.Desktop.ConnectionToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:YuandaoTws.Domain.Enums;assembly=YuandaoTws.Domain"
        xmlns:conv="clr-namespace:YuandaoTws.Desktop.Converters"
        Title="原点耳机已连接"
        Width="460" Height="350"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True"
        Background="Transparent" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBoolean" />
        <Style x:Key="ToastLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="ToastValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border x:Name="Shell"
            Background="#EEF7FAFC"
            BorderBrush="#B8FFFFFF"
            BorderThickness="1"
            CornerRadius="22"
            Padding="18,15,18,16"
            Effect="{StaticResource FloatingShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="152" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonUp="OpenMainWindow" Cursor="Hand">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeviceName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="原点耳机 · 已连接" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1A1B9A67" CornerRadius="12" Padding="9,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="连接成功" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" x:Name="WithCasePanel" Opacity="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.32*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#26FFFFFF" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="15" Padding="7,5" Margin="0,0,5,0">
                    <StackPanel>
                        <Image x:Name="ToastLeftImage" Height="84" Width="76" Stretch="Uniform" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                        <TextBlock Text="左耳" Style="{StaticResource ToastLabel}" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding LeftBatteryText}" Style="{StaticResource ToastValue}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#26FFFFFF" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="15" Padding="7,5" Margin="2,0,3,0">
                    <StackPanel>
                        <Image x:Name="ToastRightImage" Height="84" Width="76" Stretch="Uniform" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                        <TextBlock Text="右耳" Style="{StaticResource ToastLabel}" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding RightBatteryText}" Style="{StaticResource ToastValue}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="CaseItem" Grid.Column="2" Background="#32FFFFFF" BorderBrush="#58FFFFFF" BorderThickness="1" CornerRadius="15" Padding="7,5" Margin="3,0,0,0" RenderTransformOrigin="0.5,0.5">
                    <StackPanel>
                        <Image x:Name="ToastCaseImage" Height="84" Width="132" Stretch="Uniform" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                        <TextBlock Text="充电盒" Style="{StaticResource ToastLabel}" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding CaseBatteryText}" Style="{StaticResource ToastValue}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" x:Name="WithoutCasePanel" Width="320" HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#26FFFFFF" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="17" Padding="12,6" Margin="0,0,6,0">
                    <StackPanel>
                        <Image x:Name="ToastLeftImageNoCase" Height="88" Width="82" Stretch="Uniform" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                        <TextBlock Text="左耳" Style="{StaticResource ToastLabel}" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding LeftBatteryText}" Style="{StaticResource ToastValue}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#26FFFFFF" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="17" Padding="12,6" Margin="6,0,0,0">
                    <StackPanel>
                        <Image x:Name="ToastRightImageNoCase" Height="88" Width="82" Stretch="Uniform" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                        <TextBlock Text="右耳" Style="{StaticResource ToastLabel}" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding RightBatteryText}" Style="{StaticResource ToastValue}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,11,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#26FFFFFF" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="11" Padding="10,7" MouseLeftButtonUp="OpenMainWindow" Cursor="Hand">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,1,8,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="{Binding AncStatusText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ConnectionSubText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button Content="打开控制中心" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="9,5" Background="#26FFFFFF" BorderBrush="#48FFFFFF" BorderThickness="1" Foreground="{StaticResource AccentBrush}" FontSize="10" Click="OpenMainWindow" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="#20FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="11" Padding="3" Margin="0,8,0,0">
                    <UniformGrid Columns="6">
                        <RadioButton Style="{StaticResource SegmentItem}" Content="关闭" IsChecked="{Binding AncMode, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Off}" Command="{Binding SetAncCommand}" CommandParameter="{x:Static enums:NoiseCancellingMode.Off}" />
                        <RadioButton Style="{StaticResource SegmentItem}" Content="通透" IsChecked="{Binding AncMode, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Transparency}" Command="{Binding SetAncCommand}" CommandParameter="{x:Static enums:NoiseCancellingMode.Transparency}" />
                        <RadioButton Style="{StaticResource SegmentItem}" Content="普通" IsChecked="{Binding AncMode, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Normal}" Command="{Binding SetAncCommand}" CommandParameter="{x:Static enums:NoiseCancellingMode.Normal}" />
                        <RadioButton Style="{StaticResource SegmentItem}" Content="深度" IsChecked="{Binding AncMode, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Deep}" Command="{Binding SetAncCommand}" CommandParameter="{x:Static enums:NoiseCancellingMode.Deep}" />
                        <RadioButton Style="{StaticResource SegmentItem}" Content="试验" IsChecked="{Binding AncMode, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=Experimental}" Command="{Binding SetAncCommand}" CommandParameter="{x:Static enums:NoiseCancellingMode.Experimental}" />
                        <RadioButton Style="{StaticResource SegmentItem}" Content="风噪" IsChecked="{Binding AncMode, Mode=TwoWay, Converter={StaticResource EnumToBoolean}, ConverterParameter=WindSuppression}" Command="{Binding SetAncCommand}" CommandParameter="{x:Static enums:NoiseCancellingMode.WindSuppression}" />
                    </UniformGrid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
