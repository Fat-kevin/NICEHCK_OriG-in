<Window x:Class="YuandaoTws.App.VerifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="协议自动校验"
        Height="720" Width="980"
        MinHeight="580" MinWidth="860"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="协议自动校验 · 判定控制通道与协议格式"
                       FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                       FontSize="12" TextWrapping="Wrap" MaxWidth="540" />
        </DockPanel>

        <!-- 设备与操作 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="设备" VerticalAlignment="Center" FontSize="12" />
                <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedDevice}" Width="300" Margin="8,0,0,0"
                          VerticalContentAlignment="Center" />
                <Button Content="刷新已配对设备" Command="{Binding RefreshDevicesCommand}" Padding="12,5" Margin="8,0,0,0" />
                <Button Content="开始自动校验" Command="{Binding RunVerifyCommand}" Padding="16,6" Margin="10,0,0,0"
                        FontWeight="SemiBold" />
                <TextBlock Text="自动逐个候选服务开流，发 NiceHCK（4E）与原道变体（03）两组查询，约 1-2 分钟。"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           Margin="10,0,0,0" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!-- 结果表格 -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                Background="{StaticResource PanelBrush}">
            <DataGrid ItemsSource="{Binding Results}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" RowHeaderWidth="0"
                      BorderThickness="0" Background="Transparent"
                      GridLinesVisibility="Horizontal"
                      FontFamily="Consolas" FontSize="12"
                      Margin="4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="服务" Binding="{Binding ServiceName}" Width="*" />
                    <DataGridTextColumn Header="服务 UUID" Binding="{Binding ServiceId}" Width="235" />
                    <DataGridTextColumn Header="开流结果" Binding="{Binding OpenResult}" Width="130" />
                    <DataGridTextColumn Header="NiceHCK 帧" Binding="{Binding NiceHckFrameCount}" Width="90" />
                    <DataGridTextColumn Header="原道帧" Binding="{Binding YuandaoFrameCount}" Width="80" />
                    <DataGridTextColumn Header="判定" Binding="{Binding FormatText}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 进度日志标题 -->
        <TextBlock Grid.Row="3" Text="进度日志 — 每一步的收发 hex 与双解析器结果"
                   FontWeight="SemiBold" Margin="2,12,0,6" FontSize="12.5" />

        <!-- 进度日志 -->
        <Border Grid.Row="4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                Background="{StaticResource PanelBrush}">
            <ListBox ItemsSource="{Binding Phases}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11.5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding Direction}" Margin="12,0,0,0" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Stage}" Margin="12,0,0,0" Foreground="#0B6BCB" />
                            </StackPanel>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 底部 -->
        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="另存报告" Command="{Binding SaveReportCommand}" Padding="12,5" />
                <TextBlock Text="{Binding ReportPath}" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                           TextTrimming="CharacterEllipsis" MaxWidth="760" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
